{% liquid
  assign text_heading = section.settings.heading | default: 'Heading'
  assign background_color = section.settings.background_color | default: '#FFFFFF'

  assign icon_height = section.settings.icon_height
%}
{% style %}
  .icon-row-section {
    background: {{background_color}};
  }
  .icon-row-image {
    height: {{ icon_height }}px;
  }
{% endstyle %}

<div class="icon-row-section tw:py-16">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="tw:text-heading! tw:font-bold! tw:text-center tw:mb-12 icon-row-heading">
        {{ text_heading }}
      </h2>
    {% endif %}

    <div class="icon-row-grid tw:flex tw:justify-between tw:max-mob:justify-center tw:gap-8 tw:flex-wrap">
      {% for block in section.blocks %}
        <div
          class="icon-row-item tw:min-w-[100px] tw:flex tw:flex-col tw:items-center tw:text-center tw:gap-6"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.icon != blank %}
            <div class="icon-row-image tw:w-auto">
              {{
                block.settings.icon
                | image_url: width: 400
                | image_tag: loading: 'lazy', class: 'tw:w-full tw:h-full tw:object-contain'
              }}
            </div>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="icon-row-text tw:text-custom_black! tw:font-bold">
              {{ block.settings.text }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Icon Row",
  "tag": "section",
  "class": "section-icon-row",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "icon_height",
      "label": "Icon Height",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f3f3ee"
    }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Feature"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Icon Row",
      "category": "Custom"
    }
  ]
}
{% endschema %}
