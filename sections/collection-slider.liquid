{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'collection-slider-price.css' | asset_url | stylesheet_tag }}

<style>
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .collection-slider-swiper-{{ section.id }} {
    display: none;
  }

  .collection-slider-swiper-{{ section.id }}.swiper-initialized {
    display: block;
  }
</style>

<div class="collection-slider section-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="tw:mb-10 tw:font-bold! tw:text-sub_heading!">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% assign selected_collection = section.settings.collection %}

    <div class="tw:flex tw:items-center tw:gap-4 tw:group">
      <button class="collection-slider__arrow--prev tw:invisible tw:group-hover:visible">
        <div class="tw:cursor-pointer tw:rotate-90 tw:flex tw:items-center tw:justify-center tw:h-10 tw:w-10">{{ 'icon-caret.svg' | inline_asset_content }}</div>
      </button>
      <div class="tw:w-full swiper collection-slider-swiper-{{ section.id }}">
        <div class="swiper-wrapper">
          {% for product in selected_collection.products %}
            <div class="swiper-slide">
              {% render 'collection-slider-card',
                card_product: product,
                lazy_load: true,
                section_id: section.id,
                skip_styles: true,
              %}
            </div>
          {% endfor %}
        </div>
      </div>
      <button class="collection-slider__arrow--next tw:invisible tw:group-hover:visible">
        <div class="tw:cursor-pointer tw:rotate-270 tw:flex tw:items-center tw:justify-center tw:h-10 tw:w-10">{{ 'icon-caret.svg' | inline_asset_content }}</div>
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.collection-slider-swiper-{{ section.id }}', {
      loop: true,
      spaceBetween: {{ section.settings.space_between }},
      navigation: {
        nextEl: '.section-{{ section.id }} .collection-slider__arrow--next',
        prevEl: '.section-{{ section.id }} .collection-slider__arrow--prev'
      },
      breakpoints: {
        0: {
          slidesPerView: {{ section.settings.mobile_products }}
        },
        768: {
          slidesPerView: {{ section.settings.tablet_products }}
        },
        990: {
          slidesPerView: {{ section.settings.desktop_products }}
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Collection Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Novelties"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "desktop_products",
      "label": "Products on desktop",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "tablet_products",
      "label": "Products on tablet",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_products",
      "label": "Products on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "space_between",
      "label": "Space between products",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Collection Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}
